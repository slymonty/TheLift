# ─────────────────────────────────────────────
# Unity .gitignore
# Rename to exactly:  .gitignore
# Place in repo root (same folder as Assets/ and ProjectSettings/)
# ─────────────────────────────────────────────

# Unity generated folders
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/

# Asset meta data — ONLY ignore metas for ignored folders
!/[Aa]ssets/**/*.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# IDE folders
.vs/
.vscode/
.idea/
.gradle/

# OS junk
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Unity3D generated crash report
sysinfo.txt

# Builds
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86
*.x86_64

# Crashlytics
crashlytics-build.properties

# Packed addressables
/[Aa]ssets/[Aa]ddressable[Aa]ssets[Dd]ata/*/*.bin*
/[Ss]treamingAssets/aa.meta
/[Ss]treamingAssets/aa/*

# Test harness output (gauntlet loop results)
/GauntletResults/
*.gauntlet.json

# ─────────────────────────────────────────────
# CRITICAL — WHAT MUST STAY TRACKED:
#
#   Assets/              — everything, including ALL .meta files
#   ProjectSettings/     — project configuration
#   Packages/            — manifest.json + packages-lock.json
#   docs/                — design bible
#
# .meta FILES ARE NOT OPTIONAL. Unity stores GUIDs and import
# settings in them. Losing a .meta breaks every reference to
# that asset. Never ignore them inside Assets/.
# ─────────────────────────────────────────────
